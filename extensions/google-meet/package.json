{
  "name": "@hanzo/bot-google-meet",
  "version": "2026.7.2",
  "description": "Bot Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.1",
    "pretty-ms": "9.3.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*",
    "@hanzo/bot": "workspace:*"
  },
  "peerDependencies": {
    "@hanzo/bot": ">=2026.7.2"
  },
  "peerDependenciesMeta": {
    "@hanzo/bot": {
      "optional": true
    }
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@hanzo/bot-google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

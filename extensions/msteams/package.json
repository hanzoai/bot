{
  "name": "@hanzo/bot-msteams",
  "version": "1.4.2",
  "description": "HanzoBot Microsoft Teams channel plugin",
  "type": "module",
  "dependencies": {
    "@microsoft/agents-hosting": "catalog:",
    "express": "catalog:"
  },
  "hanzo-bot": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "msteams",
      "label": "Microsoft Teams",
      "selectionLabel": "Microsoft Teams (Bot Framework)",
      "docsPath": "/channels/msteams",
      "docsLabel": "msteams",
      "blurb": "Bot Framework; enterprise support.",
      "aliases": [
        "teams"
      ],
      "order": 60
    },
    "install": {
      "npmSpec": "@hanzo/bot-msteams",
      "localPath": "extensions/msteams",
      "defaultChoice": "npm"
    }
  }
}

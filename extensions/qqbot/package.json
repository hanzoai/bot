{
  "name": "@hanzo/bot-qqbot",
  "version": "2026.7.2",
  "private": false,
  "description": "Bot QQ Bot channel plugin for group and direct-message workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "mpg123-decoder": "1.0.3",
    "p-map": "7.0.5",
    "pretty-ms": "9.3.0",
    "silk-wasm": "3.7.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*",
    "@types/ws": "8.18.1",
    "@hanzo/bot": "workspace:*"
  },
  "peerDependencies": {
    "@hanzo/bot": ">=2026.7.2"
  },
  "peerDependenciesMeta": {
    "@hanzo/bot": {
      "optional": true
    }
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "qqbot",
      "configuredState": {
        "env": {
          "anyOf": [
            "QQBOT_APP_ID",
            "QQBOT_CLIENT_SECRET"
          ]
        }
      },
      "approvalFlags": [
        "native"
      ],
      "label": "QQ Bot",
      "selectionLabel": "QQ Bot (Official API)",
      "detailLabel": "QQ Bot",
      "docsPath": "/channels/qqbot",
      "docsLabel": "qqbot",
      "blurb": "connect to QQ via official QQ Bot API with group chat and direct message support.",
      "systemImage": "bubble.left.and.bubble.right",
      "setup": {
        "fields": [
          {
            "key": "token",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--token <appId:secret>",
              "description": "QQBot app id and client secret"
            }
          },
          {
            "key": "tokenFile",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--token-file <path>",
              "description": "QQBot client secret file"
            }
          },
          {
            "key": "useEnv",
            "kind": "boolean",
            "cli": {
              "flags": "--use-env",
              "description": "Use QQBOT environment credentials"
            }
          }
        ]
      }
    },
    "install": {
      "npmSpec": "@hanzo/bot-qqbot",
      "localPath": "extensions/qqbot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

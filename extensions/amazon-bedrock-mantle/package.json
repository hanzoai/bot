{
  "name": "@hanzo/bot-amazon-bedrock-mantle-provider",
  "version": "2026.7.2",
  "description": "Bot Amazon Bedrock Mantle provider plugin for OpenAI-compatible model routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@aws/bedrock-token-generator": "1.1.0"
  },
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*"
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@hanzo/bot-amazon-bedrock-mantle-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

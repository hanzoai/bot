{
  "name": "@hanzo/bot-matrix",
  "version": "1.4.2",
  "description": "HanzoBot Matrix channel plugin",
  "type": "module",
  "dependencies": {
    "@mariozechner/pi-agent-core": "catalog:",
    "@matrix-org/matrix-sdk-crypto-nodejs": "catalog:",
    "@vector-im/matrix-bot-sdk": "catalog:",
    "markdown-it": "catalog:",
    "music-metadata": "catalog:",
    "zod": "catalog:"
  },
  "hanzo-bot": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "matrix",
      "label": "Matrix",
      "selectionLabel": "Matrix (plugin)",
      "docsPath": "/channels/matrix",
      "docsLabel": "matrix",
      "blurb": "open protocol; install the plugin to enable.",
      "order": 70,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@hanzo/bot-matrix",
      "localPath": "extensions/matrix",
      "defaultChoice": "npm"
    }
  }
}

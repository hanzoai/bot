{
  "name": "@hanzo/bot-amazon-bedrock-provider",
  "version": "2026.7.2",
  "description": "Bot Amazon Bedrock provider plugin with model discovery, embeddings, and guardrail support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1090.0",
    "@aws-sdk/client-bedrock-runtime": "3.1090.0",
    "@aws-sdk/credential-provider-node": "3.972.70",
    "@smithy/node-http-handler": "4.9.7",
    "@smithy/shared-ini-file-loader": "4.6.10",
    "@smithy/types": "4.16.1"
  },
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*"
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@hanzo/bot-amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

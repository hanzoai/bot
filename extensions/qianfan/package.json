{
  "name": "@hanzo/bot-qianfan-provider",
  "version": "2026.7.2",
  "description": "Bot Qianfan provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*"
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@hanzo/bot-qianfan-provider",
      "npmSpec": "@hanzo/bot-qianfan-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

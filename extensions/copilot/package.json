{
  "name": "@hanzo/bot-copilot",
  "version": "2026.7.2",
  "description": "Bot GitHub Copilot agent runtime plugin (registers a `github-copilot` AgentHarness backed by @github/copilot-sdk over JSON-RPC to the GitHub Copilot CLI)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/bot"
  },
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "1.0.7"
  },
  "devDependencies": {
    "@hanzo/bot-plugin-sdk": "workspace:*"
  },
  "bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@hanzo/bot-copilot",
      "npmSpec": "@hanzo/bot-copilot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.7.2"
    },
    "build": {
      "botVersion": "2026.7.2",
      "bundledDist": false
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}

// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

BOT_CODE_SIGN_STYLE = Automatic
BOT_CODE_SIGN_IDENTITY = Apple Development
BOT_DEVELOPMENT_TEAM = YOUR_TEAM_ID

BOT_APP_BUNDLE_ID = ai.botfoundation.app
BOT_SHARE_BUNDLE_ID = ai.botfoundation.app.share
BOT_APP_GROUP_ID = group.ai.botfoundation.app.shared
BOT_ACTIVITY_WIDGET_BUNDLE_ID = ai.botfoundation.app.activitywidget
BOT_WATCH_APP_BUNDLE_ID = ai.botfoundation.app.watchkitapp

// Leave empty with automatic signing.
BOT_APP_PROFILE =
BOT_SHARE_PROFILE =
BOT_ACTIVITY_WIDGET_PROFILE =
BOT_WATCH_APP_PROFILE =

// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "build/Version.xcconfig"

BOT_CODE_SIGN_STYLE = Manual
BOT_CODE_SIGN_IDENTITY = Apple Development
BOT_CODE_SIGN_ENTITLEMENTS = Sources/Bot.entitlements
BOT_DEVELOPMENT_TEAM = FWJYW4S8P8

BOT_APP_BUNDLE_ID = ai.botfoundation.app
BOT_SHARE_BUNDLE_ID = ai.botfoundation.app.share
BOT_APP_GROUP_ID = group.ai.botfoundation.app.shared
BOT_WATCH_APP_BUNDLE_ID = ai.botfoundation.app.watchkitapp
BOT_ACTIVITY_WIDGET_BUNDLE_ID = ai.botfoundation.app.activitywidget
BOT_APNS_ENTITLEMENT_ENVIRONMENT = development

BOT_APP_PROFILE = ai.botfoundation.app Development
BOT_SHARE_PROFILE = ai.botfoundation.app.share Development
BOT_ACTIVITY_WIDGET_PROFILE =
BOT_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
BOT_DEBUG_APP_BUNDLE_ID = $(BOT_APP_BUNDLE_ID).debug
BOT_DEBUG_SHARE_BUNDLE_ID = $(BOT_DEBUG_APP_BUNDLE_ID).share
BOT_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(BOT_DEBUG_APP_BUNDLE_ID).activitywidget
BOT_DEBUG_WATCH_APP_BUNDLE_ID = $(BOT_DEBUG_APP_BUNDLE_ID).watchkitapp
BOT_DEBUG_APP_GROUP_ID = $(BOT_APP_GROUP_ID).debug

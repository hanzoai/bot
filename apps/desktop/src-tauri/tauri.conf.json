{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo Bot",
  "version": "2026.6.7",
  "identifier": "com.hanzo.bot",
  "mainBinaryName": "hanzo-bot",
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Hanzo Bot",
        "url": "http://127.0.0.1:5173",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "center": true
      }
    ]
  }
}
